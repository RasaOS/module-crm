#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""check-crm — validate the crm ledger against .claude/crm-rules.md.

Exit 0 = no errors (warnings allowed), 1 = errors, 2 = cannot run.
`--fix` repairs the mechanical subset and never invents a person or a date.
"""
import os
import sys

sys.dont_write_bytecode = True
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)

from rasa_crm import validate  # noqa: E402

if __name__ == "__main__":
    sys.exit(validate.main(bin_dir=os.path.dirname(os.path.abspath(__file__))))
